# Copy to .env at repo root for docker compose. Never commit real values.
# Compose auto-loads this file; required keys fail fast via ${VAR:?message}.

ARCHIVE_FINGERPRINT_KEYS=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=
WORKOS_COOKIE_PASSWORD=
APP_SESSION_KEYS=

# Optional local overrides
# RUST_LOG=info
# LOG_FORMAT=pretty
# AUTH_SECURE_COOKIES=false
# API_PUBLISH_HOST=127.0.0.1
# POSTGRES_PUBLISH_HOST=127.0.0.1
# MINIO_PUBLISH_HOST=127.0.0.1
# WORKOS_SEAL_KEY_VERSION=workos_v1

# Durable-upload smoke (scripts/local-upload-smoke.sh) — native bearer after WorkOS exchange:
# GP_TEST_SESSION=

# SST staging/production non-secret settings. Prefer ignored .env.staging/.env.production.
AWS_PROFILE=ghostpost-deployer
AWS_REGION=us-east-1
GHOSTPOST_APP_DOMAIN=app.example.com
GHOSTPOST_API_DOMAIN=api.example.com
GHOSTPOST_COOKIE_SITE=example.com
DATABASE_APP_ROLE=ghostpost_app
POSTGRES_PITR_RETENTION_DAYS=7
DELETION_LEDGER_RETENTION_DAYS=14
GIT_SHA=replace-with-image-source-sha
RESTORE_REPLAY_PENDING=false
SCAN_LLM_APPROVAL_MANIFEST_PATH=/secure/path/deepseek-approval.json
SCAN_PROMPT_SHA256=replace-with-64-lowercase-hex
SCAN_SCHEMA_SHA256=replace-with-64-lowercase-hex
