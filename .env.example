# Copy to .env at repo root for docker compose. Never commit real values.
# Compose auto-loads this file; required keys fail fast via ${VAR:?message}.

ARCHIVE_FINGERPRINT_KEYS=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=
WORKOS_COOKIE_PASSWORD=
APP_SESSION_KEYS=

# Optional overrides
# RUST_LOG=info
# LOG_FORMAT=pretty
# AUTH_SECURE_COOKIES=false
# API_PUBLISH_HOST=127.0.0.1
# POSTGRES_PUBLISH_HOST=127.0.0.1
# MINIO_PUBLISH_HOST=127.0.0.1
# WORKOS_SEAL_KEY_VERSION=workos_v1

# Durable-upload smoke (scripts/local-upload-smoke.sh) — native bearer after WorkOS exchange:
# GP_TEST_SESSION=
