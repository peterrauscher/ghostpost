# Copy to backend/.env for host-native runs. Never commit real secrets.
DATABASE_URL=postgres://ghostpost_migrator:ghostpost_migrator@127.0.0.1:5432/ghostpost
DATABASE_URL_APP=postgres://ghostpost_app:ghostpost_app@127.0.0.1:5432/ghostpost
DATABASE_APP_ROLE=ghostpost_app
DB_MAX_CONNECTIONS=10
MIGRATION_MAX_CONNECTIONS=2
MIGRATION_LOCK_TIMEOUT_SECS=60
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,ghostpost_backend=debug,sqlx=warn
LOG_FORMAT=pretty
INSTANCE_ID=dev-local
WORKER_LEASE_SECS=60
WORKER_HEARTBEAT_SECS=20
WORKER_SWEEPER_SECS=30
SHUTDOWN_DEADLINE_SECS=30
RESTORE_REPLAY_PENDING=false
GHOSTPOST_ENV=development

# Plan 003 auth (required for serve --role api|worker|all)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=
WORKOS_COOKIE_PASSWORD=
WORKOS_SEAL_KEY_VERSION=workos_v1
# Optional previous password for `auth reseal-workos-sessions`
# WORKOS_COOKIE_PASSWORD_PREVIOUS=
APP_SESSION_KEYS=[{"id":"local_v1","secret":"<base64-32-byte-local-secret>"}]
AUTH_WEB_REDIRECT_URI=http://localhost:8081/auth/callback
AUTH_NATIVE_REDIRECT_URI=ghostpost://auth/callback
AUTH_WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
AUTH_INIT_COOKIE_MAX_AGE_SECS=600
APP_SESSION_MAX_AGE_SECS=2592000
CSRF_TOKEN_MAX_AGE_SECS=3600
# Local HTTP smoke may set false; production must be true/omitted (defaults true)
# AUTH_SECURE_COOKIES=false

# Plan 004 archive blob store (Compose MinIO local defaults)
ARCHIVE_BUCKET=ghostpost-archives
ARCHIVE_S3_ENDPOINT=http://127.0.0.1:9000
ARCHIVE_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_ACCESS_KEY_ID=ghostpost
ARCHIVE_S3_SECRET_ACCESS_KEY=ghostpostsecret
# Runtime S3 SDK uses the standard AWS credential chain:
AWS_ACCESS_KEY_ID=ghostpost
AWS_SECRET_ACCESS_KEY=ghostpostsecret
ARCHIVE_S3_FORCE_PATH_STYLE=true
# MinIO has no AWS KMS — required false for local signed POST
ARCHIVE_S3_REQUIRE_KMS=false
ARCHIVE_UPLOAD_TTL_SECS=900
ARCHIVE_FINGERPRINT_KEYS=[{"version":1,"secret":"<base64-32-byte-local-secret>"}]
ARCHIVE_RAW_RETENTION_HOURS=24
ARCHIVE_MAX_BYTES=2147483648

# Plan 005 scan / LLM
SCAN_LLM_PROVIDER=stub-deterministic
DEEPSEEK_API_KEY=
SCAN_LLM_APPROVAL_MANIFEST_PATH=evals/manifests/approval/deepseek-v4-flash.manifest.json
SCAN_LLM_APPROVAL_MANIFEST_JSON=
SCAN_BATCH_HMAC_KEYS=[{"id":"local_v1","secret":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}]
SCAN_BATCH_MAX_TOKENS=12000
SCAN_BATCH_MAX_ITEMS=16
SCAN_BATCH_MAX_SCALARS=6000
SCAN_LLM_MAX_INFLIGHT=4
