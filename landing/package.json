{
  "name": "ghostpost-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc -p worker",
    "build": "astro build",
    "db:migrate:local": "wrangler d1 migrations apply ghostpost-waitlist --local",
    "preview": "astro build && bun run db:migrate:local && wrangler dev --port 8788",
    "deploy": "wrangler d1 migrations apply ghostpost-waitlist --remote && astro build && wrangler deploy",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "astro": "^7.3.5",
    "lucide-static": "^1.48.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "wrangler": "^4.142.0"
  }
}
