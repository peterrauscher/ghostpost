---
import Logo from './Logo.astro';

const columns = [
  {
    title: 'social',
    links: [
      { href: 'https://x.com/getghostpost', label: 'X (formerly Twitter)' },
      { href: 'https://www.linkedin.com/company/getghostpost', label: 'LinkedIn' },
      { href: 'https://www.tiktok.com/@getghostpost', label: 'TikTok (coming soon)' },
    ],
  },
  {
    title: 'company',
    links: [
      { href: '/faq', label: 'FAQ' },
      { href: '/contact', label: 'Contact Us' },
      { href: '/terms', label: 'Terms of Service' },
      { href: '/privacy', label: 'Privacy Policy' },
    ],
  },
  {
    title: 'resources',
    links: [
      { href: '/#how', label: 'how it works' },
      { href: '/#receipts', label: 'the receipts' },
      { href: '/#join', label: 'join the waitlist' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo />
      <p>scan, review, and clean up your social media before it counts.</p>
      <p class="footer__legal">© {year} ghostpost</p>
    </div>
    <div class="footer__cols">
      {columns.map((column) => (
        <nav aria-label={column.title}>
          <h3>{column.title}</h3>
          <ul>
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer { padding: 120px 0; border-top: 1px solid var(--border); }
  .footer__inner { display: flex; justify-content: space-between; gap: 48px; }
  .footer__brand { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; max-width: 320px; }
  .footer__brand p { font-size: 14px; line-height: 1.5; color: var(--muted); }
  .footer__brand .footer__legal { margin-top: 24px; font-size: 13px; }
  .footer__cols { display: flex; flex-wrap: wrap; gap: 72px 96px; }
  .footer__cols h3 { font-size: 18px; font-weight: 750; line-height: 1; letter-spacing: -0.02em; }
  .footer__cols ul { display: flex; flex-direction: column; gap: 24px; margin-top: 24px; }
  .footer__cols a { font-size: 14px; line-height: 1; color: rgb(23 23 23 / 0.7); transition: color 0.2s ease; }
  .footer__cols a:hover { color: var(--accent); }
  @media (max-width: 767px) {
    .footer { padding: 72px 0; }
    .footer__inner { flex-direction: column; }
    .footer__cols { gap: 48px; }
  }
</style>
