---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  body: string;
  bullets: readonly { icon: IconName; text: string }[];
  reverse?: boolean;
}

const { id, eyebrow, title, body, bullets, reverse = false } = Astro.props;
---

<article class:list={['feature', { 'feature--reverse': reverse }]} id={id}>
  <div class="feature__copy" data-reveal>
    <p class="feature__eyebrow">{eyebrow}</p>
    <h3 class="feature__title">{title}</h3>
    <p class="feature__body">{body}</p>
    <ul class="feature__list">
      {bullets.map((bullet) => (
        <li>
          <span class="feature__icon"><Icon name={bullet.icon} size={15} strokeWidth={2.4} /></span>
          {bullet.text}
        </li>
      ))}
    </ul>
  </div>
  <div class="feature__media" data-reveal style="--reveal-delay: 120ms">
    <slot />
  </div>
</article>

<style>
  /* Measured from orchid.ai feature rows: 440px media, 64px gap, 28px title → 12 → body → 44 → list (48px rows) → 44 → CTA. */
  .feature {
    display: flex;
    align-items: center;
    gap: 64px;
  }
  .feature--reverse { flex-direction: row-reverse; }
  .feature__copy { flex: 1; min-width: 0; }
  .feature__eyebrow {
    margin-bottom: 10px;
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
  }
  .feature__title {
    font-size: 30px;
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .feature__body {
    max-width: 470px;
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .feature__list {
    max-width: 470px;
    margin-top: 44px;
  }
  .feature__list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    font-size: 16px;
    font-weight: 550;
    color: rgb(23 23 23 / 0.78);
  }
  .feature__list li + li { border-top: 1px solid var(--border); }
  .feature__icon {
    width: 26px;
    height: 26px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .feature__media {
    position: relative;
    flex: none;
    width: 540px;
    height: 440px;
    border-radius: 32px;
    overflow: hidden;
    isolation: isolate;
  }

  @media (max-width: 1023px) {
    .feature,
    .feature--reverse { flex-direction: column; align-items: stretch; gap: 40px; }
    .feature__media { width: 100%; height: auto; aspect-ratio: 540 / 440; }
  }
  @media (max-width: 767px) {
    .feature__title { font-size: 26px; }
    .feature__list { margin-top: 32px; }
  }
</style>
