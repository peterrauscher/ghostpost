---
import { Image } from 'astro:assets';
import logoGhost from '@app-assets/images/logo-trim.png';
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  body: string;
  action: { href: string; label: string };
}

const { title, description, path, heading, body, action } = Astro.props;
---

<Base title={title} description={description} path={path} noindex>
  <main class="notice">
    <Image class="bob" src={logoGhost} alt="" width={120} densities={[1, 2]} loading="eager" />
    <h1>{heading}</h1>
    <p>{body}</p>
    <a class="pill pill--primary pill--lg" href={action.href}>{action.label}</a>
  </main>
</Base>

<style>
  .notice {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 24px;
    background: var(--grad-welcome);
    text-align: center;
  }
  h1 { font-size: clamp(36px, 6vw, 56px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.05; text-wrap: balance; }
  p { max-width: 420px; margin-bottom: 12px; color: var(--muted); text-wrap: pretty; }
</style>
