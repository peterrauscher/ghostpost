---
import { Image } from 'astro:assets';
import { PLATFORMS } from '../demo/data';
import { platformIcons } from '../lib/platform-icons';
import PhoneDemo from './PhoneDemo.astro';
import WaitlistForm from './WaitlistForm.astro';

// Orbiting platform tiles around the phone, echoing the app's welcome-screen art.
const orbit = [
  { style: '--x:-300px; --y:120px; --r:-12deg; --bob-delay:0s' },
  { style: '--x:268px; --y:40px; --r:14deg; --bob-delay:-1.2s' },
  { style: '--x:300px; --y:360px; --r:-8deg; --bob-delay:-2.4s' },
  { style: '--x:-330px; --y:420px; --r:10deg; --bob-delay:-3.1s' },
  { style: '--x:250px; --y:620px; --r:6deg; --bob-delay:-0.6s' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    <h1 id="hero-title" class="hero__title">
      let’s clean <span class="hero__accent">your slate.</span>
    </h1>
    <p class="hero__lede">
      ghostpost scans your social media and helps you find the posts that could hold you back, before
      admissions, recruiters, or rush ever see them.
    </p>
    <WaitlistForm source="hero" />

    <div class="hero__stage">
      {PLATFORMS.map(({ id, label }, i) => (
        <span class="hero__tile bob" style={orbit[i].style} aria-hidden="true">
          <Image src={platformIcons[id]} alt={label} width={34} densities={[1, 2]} />
        </span>
      ))}
      <PhoneDemo />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: 144px 0 96px;
    background: var(--grad-welcome);
  }
  .hero::after {
    /* Melt the lavender hero into the page tint. */
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 420px;
    background: linear-gradient(180deg, rgb(250 250 252 / 0) 0%, var(--tint) 100%);
    z-index: -1;
  }
  .hero__glow {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: -240px;
    width: 1100px;
    height: 900px;
    margin-left: -550px;
    background:
      radial-gradient(closest-side at 30% 40%, rgb(167 139 250 / 0.28), transparent),
      radial-gradient(closest-side at 72% 55%, rgb(255 214 236 / 0.55), transparent);
    filter: blur(20px);
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Orchid rhythm: title → 32 → lede → 32 → waitlist → 64 → device. */

  .hero__title {
    max-width: min(92vw, 760px);
    font-size: clamp(46px, 7vw, 76px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .hero__accent {
    display: block;
    color: var(--accent-deep);
    background: linear-gradient(100deg, #7f4ae0 10%, #5925be 60%, #8b6ae8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero__lede {
    max-width: min(92vw, 520px);
    margin: 32px 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .hero__stage {
    position: relative;
    margin-top: 64px;
  }
  .hero__tile {
    position: absolute;
    left: 50%;
    top: 0;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    display: grid;
    place-items: center;
    translate: var(--x) var(--y);
    --bob-dur: 6s;
  }
  /* Bare icon: the gradient behind it is light, so a soft shadow keeps it from flattening into the page. */
  .hero__tile img { width: 40px; height: auto; filter: drop-shadow(0 10px 18px rgb(38 20 80 / 0.18)); }

  @media (max-width: 900px) {
    .hero__tile { display: none; }
  }
  @media (max-width: 767px) {
    .hero { padding: 120px 0 72px; }
    .hero__lede { font-size: 16px; }
    .hero__stage { margin-top: 56px; }
  }
</style>
