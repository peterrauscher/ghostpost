---
import { Image } from 'astro:assets';
import appIcon from '@app-assets/images/logo.png';
import logoGhost from '@app-assets/images/logo-trim.png';
import Icon from '../Icon.astro';
---

<div class="art">
  <span class="art__halo" aria-hidden="true"></span>
  <Image class="art__ghost bob" src={logoGhost} alt="" width={170} densities={[1, 2]} />
  <div class="art__note">
    <Image class="art__app" src={appIcon} alt="" width={38} densities={[1, 2]} />
    <div class="art__note-copy">
      <p><strong>Ghostpost</strong><span>now</span></p>
      <p>scan complete! your live posts weren’t touched. only you can see your results 👻</p>
    </div>
  </div>
  <div class="art__pills">
    <span><Icon name="eye-off" size={15} strokeWidth={2.4} /> nothing posted, ever</span>
    <span><Icon name="shield-check" size={15} strokeWidth={2.4} /> private by default</span>
  </div>
</div>

<style>
  .art {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    background:
      radial-gradient(circle at 50% 30%, rgb(167 139 250 / 0.55), transparent 55%),
      linear-gradient(160deg, #3b1a86 0%, #5925be 55%, #7f4ae0 100%);
    color: #fff;
  }
  .art__halo {
    position: absolute;
    top: 50px;
    left: 50%;
    width: 240px;
    height: 240px;
    margin-left: -120px;
    border-radius: 999px;
    background: radial-gradient(circle, rgb(255 255 255 / 0.35), transparent 65%);
  }
  .art__ghost { position: relative; width: 150px; height: auto; filter: drop-shadow(0 20px 30px rgb(20 8 50 / 0.45)); }
  .art__note {
    width: min(360px, 86%);
    display: flex;
    gap: 12px;
    padding: 14px;
    border-radius: 24px;
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 18px 40px rgb(20 8 50 / 0.35);
    color: var(--fg);
  }
  .art__app { width: 38px; height: 38px; flex: none; border-radius: 10px; }
  .art__note-copy { font-size: 14px; line-height: 1.35; }
  .art__note-copy p:first-child { display: flex; justify-content: space-between; margin-bottom: 2px; }
  .art__note-copy span { font-size: 12px; color: var(--muted); }
  .art__pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .art__pills span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
    font-size: 13px;
    font-weight: 600;
  }
</style>
