---
import { Image } from 'astro:assets';
import logoGhost from '@app-assets/images/logo-trim.png';

// Concern categories come from the app's onboarding (CONCERN_OPTIONS).
const concerns = [
  { emoji: '🍻', label: 'drinking / drugs', result: '2 found', tone: 'high' },
  { emoji: '🤬', label: 'inappropriate language', result: '3 found', tone: 'medium' },
  { emoji: '😤', label: 'negativity', result: '2 found', tone: 'medium' },
  { emoji: '🗳️', label: 'political takes', result: '1 found', tone: 'low' },
  { emoji: '✨', label: 'public image', result: 'looks good', tone: 'ok' },
] as const;
---

<div class="art art--scan">
  <ul class="art__bubbles">
    {concerns.map((concern, i) => (
      <li class:list={['art__bubble', `art__bubble--${concern.tone}`]} style={`--i:${i}`}>
        <span class="art__emoji" aria-hidden="true">{concern.emoji}</span>
        <span class="art__label">{concern.label}</span>
        <span class="art__result">{concern.result}</span>
      </li>
    ))}
  </ul>
  <Image class="art__peek bob" src={logoGhost} alt="" width={72} densities={[1, 2]} />
</div>

<style>
  .art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 80% 10%, rgb(255 255 255 / 0.25), transparent 40%),
      var(--grad-audit);
  }
  .art__bubbles {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: min(360px, 84%);
  }
  .art__bubble {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 8px 0 8px;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 10px 24px rgb(40 20 80 / 0.18);
    font-size: 15px;
    font-weight: 600;
  }
  .art__bubble:nth-child(even) { margin-left: 28px; margin-right: -28px; }
  .art__emoji {
    width: 36px;
    height: 36px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--accent-soft);
    font-size: 17px;
  }
  .art__label { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .art__result {
    flex: none;
    height: 26px;
    display: grid;
    place-items: center;
    padding: 0 11px;
    border-radius: 13px;
    font-size: 12px;
    font-weight: 700;
  }
  .art__bubble--high .art__result { background: var(--risk-high-bg); color: var(--risk-high-text); }
  .art__bubble--medium .art__result { background: var(--risk-medium-bg); color: var(--risk-medium-text); }
  .art__bubble--low .art__result { background: var(--risk-low-bg); color: var(--risk-low-text); }
  .art__bubble--ok .art__result { background: var(--accent-soft); color: var(--accent-deep); }

  /* Bubbles pop in one by one once the row scrolls into view. */
  :global(.js) .art__bubble {
    opacity: 0;
    scale: 0.85;
    transition: opacity 0.4s ease, scale 0.5s var(--ease-bounce);
    transition-delay: calc(var(--i) * 110ms + 200ms);
  }
  :global(.is-visible) .art__bubble { opacity: 1; scale: 1; }

  .art__peek {
    position: absolute;
    right: 26px;
    bottom: 18px;
    width: 72px;
    height: auto;
    --r: -10deg;
    filter: drop-shadow(0 10px 18px rgb(40 20 80 / 0.25));
  }
  @media (max-width: 767px) {
    .art__bubble:nth-child(even) { margin-left: 16px; margin-right: -16px; }
    .art__peek { display: none; }
  }
</style>
