---
import Icon from './Icon.astro';

interface Props {
  /** Stored with the signup so we know which form converts. */
  source: 'hero' | 'cta';
  /** `light` sits on lavender backgrounds, `dark` on the purple CTA card. */
  tone?: 'light' | 'dark';
}

const { source, tone = 'light' } = Astro.props;
const inputId = `waitlist-${source}`;
---

<form class:list={['wl', `wl--${tone}`]} action="/api/waitlist" method="post" data-waitlist novalidate>
  <div class="wl__field">
    <label class="sr-only" for={inputId}>Email or phone number</label>
    <input
      id={inputId}
      class="wl__input"
      name="contact"
      type="text"
      inputmode="email"
      autocomplete="email"
      placeholder="email or phone number"
      maxlength="254"
      required
    />
    <input type="hidden" name="source" value={source} />
    <!-- Honeypot: hidden from people, irresistible to bots. -->
    <input class="wl__trap" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button class="wl__submit" type="submit">
      <span class="wl__label">join the waitlist</span>
      <Icon name="arrow-right" size={18} strokeWidth={2.4} />
    </button>
  </div>
  <p class="wl__status" role="status" aria-live="polite" data-waitlist-status></p>
  <p class="wl__fine">
    we’ll only reach out about ghostpost. by joining with a phone number you agree to get texts about our launch.
    msg &amp; data rates may apply.
  </p>
</form>

<script>
  import { mountWaitlistForm } from '../waitlist/form';
  document.querySelectorAll<HTMLFormElement>('[data-waitlist]').forEach(mountWaitlistForm);
</script>

<style>
  .wl {
    width: min(100%, 480px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .wl__field {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 60px;
    padding: 6px 6px 6px 22px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--border), 0 14px 34px rgb(89 37 190 / 0.14);
    transition: box-shadow 0.25s ease, transform 0.35s var(--ease-bounce);
  }
  .wl__field:focus-within { box-shadow: 0 0 0 3px rgb(127 74 224 / 0.35), 0 14px 34px rgb(89 37 190 / 0.18); }
  .wl[data-state='error'] .wl__field { box-shadow: 0 0 0 2px var(--risk-high), 0 14px 34px rgb(232 90 107 / 0.18); animation: wiggle 0.4s ease; }
  .wl__input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 16px;
    font-weight: 550;
    color: var(--fg);
  }
  .wl__input::placeholder { color: #a39cb0; font-weight: 500; }
  .wl__trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .wl__submit {
    flex: none;
    height: 48px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: var(--grad-button);
    box-shadow: var(--shadow-button);
    color: #fff;
    font: inherit;
    font-size: 15px;
    font-weight: 650;
    cursor: pointer;
    transition: transform 0.25s var(--ease-bounce), opacity 0.2s ease;
  }
  .wl__submit:hover { transform: scale(1.03); }
  .wl__submit:active { transform: scale(0.96); }
  .wl[data-state='sending'] .wl__submit { opacity: 0.7; pointer-events: none; }
  .wl__status { min-height: 22px; font-size: 14px; font-weight: 650; text-align: center; }
  .wl[data-state='error'] .wl__status { color: var(--risk-high-text); }
  .wl[data-state='done'] .wl__status { color: var(--accent-deep); }
  .wl__fine { max-width: 400px; font-size: 12px; line-height: 1.5; color: var(--muted); text-align: center; text-wrap: pretty; }

  /* Success swaps the pill for a celebratory confirmation. */
  .wl[data-state='done'] .wl__field { display: none; }
  .wl[data-state='done'] .wl__status {
    display: grid;
    place-items: center;
    min-height: 60px;
    padding: 0 24px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--border), 0 14px 34px rgb(89 37 190 / 0.14);
    font-size: 16px;
    animation: pop 0.5s var(--ease-bounce);
  }

  .wl--dark .wl__field { box-shadow: 0 18px 40px rgb(40 20 80 / 0.3); }
  .wl--dark .wl__submit { background: var(--black); box-shadow: var(--shadow-dark); }
  .wl--dark .wl__fine { color: rgb(255 255 255 / 0.78); }
  .wl--dark[data-state='error'] .wl__status { color: #fff; }
  .wl--dark[data-state='done'] .wl__status { box-shadow: 0 18px 40px rgb(40 20 80 / 0.3); }

  @keyframes wiggle {
    25% { transform: translateX(-6px); }
    50% { transform: translateX(5px); }
    75% { transform: translateX(-3px); }
  }
  @keyframes pop {
    from { transform: scale(0.85); opacity: 0; }
  }

  @media (max-width: 480px) {
    .wl__field {
      height: auto;
      flex-direction: column;
      padding: 0;
      background: transparent;
      box-shadow: none;
      border-radius: 0;
      gap: 10px;
    }
    .wl__field:focus-within {
      box-shadow: none;
    }
    .wl[data-state='error'] .wl__field {
      box-shadow: none;
      animation: none;
    }
    .wl__input {
      flex: none;
      width: 100%;
      height: 52px;
      padding: 0 20px;
      border-radius: 999px;
      background: #fff;
      box-shadow: 0 0 0 1px var(--border), 0 10px 24px rgb(89 37 190 / 0.10);
      text-align: center;
      font-size: 16px;
      transition: box-shadow 0.25s ease;
    }
    .wl__input:focus {
      box-shadow: 0 0 0 3px rgb(127 74 224 / 0.35), 0 14px 34px rgb(89 37 190 / 0.16);
    }
    .wl[data-state='error'] .wl__input {
      box-shadow: 0 0 0 2px var(--risk-high), 0 14px 34px rgb(232 90 107 / 0.18);
      animation: wiggle 0.4s ease;
    }
    .wl__submit {
      width: 100%;
      height: 52px;
      border-radius: 999px;
      justify-content: center;
      font-size: 16px;
    }
    .wl--dark .wl__field { box-shadow: none; }
    .wl--dark .wl__input {
      box-shadow: 0 12px 28px rgb(40 20 80 / 0.25);
    }
    .wl--dark[data-state='error'] .wl__input {
      box-shadow: 0 0 0 2px var(--risk-high), 0 14px 34px rgb(232 90 107 / 0.25);
    }
    .wl[data-state='done'] .wl__status {
      min-height: 52px;
    }
  }
</style>
